# Dockerfile "sbagliato" apposta, per la demo. Funziona, ma:
# - l'immagine finale contiene l'SDK completo (oltre 1 GB)
# - ogni modifica al codice rifa' anche il restore (nessuna cache utile)
# - il processo gira come root
# Build: docker build -f docs/esempi/Dockerfile.sbagliato -t shipboard-api:sbagliato src/ShipBoard.Api
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app
COPY . .
RUN dotnet publish -c Release -o out
ENV ASPNETCORE_HTTP_PORTS=8080
ENTRYPOINT ["dotnet", "out/ShipBoard.Api.dll"]
